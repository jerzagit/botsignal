# SignalBot environment example
# Copy to .env and fill real values. Never commit or share .env.

# ── Web portal login ──────────────────────────────────
# First visit to the dashboard forces setup if PORTAL_PASSWORD_HASH is empty.
PORTAL_USERNAME=admin
# Set via the /setup page (hashed). Do not put a plaintext password here.
PORTAL_PASSWORD_HASH=
FLASK_SECRET_KEY=

# Runtime mode
ENV_MODE=demo

# Telegram user account from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
# Optional. Leave blank to use the saved Telethon session or prompt on first login.
TG_PHONE=

# Telegram bot from @BotFather
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUR_CHAT_ID=987654321

# Signal group username or numeric ID
SIGNAL_GROUP=YourSignalGroup

# Optional: multiple Telegram signal sources.
# Format: source_id:chat:risk_percent:parser_profile:name:auto_execute
# Leave unset to use SIGNAL_GROUP as one default source.
# SIGNAL_SOURCES=mirror1:-1002083967629:0.10:default:MIRROR_1:true,bobby:@Bobbylivetrade:0.10:bobby:BOBBY_LIVE:false
SOURCE_RISK_DEFAULT=0.10
SOURCE_RISK_MODE=reduce
SOURCE_CONFLICT_MODE=allow
MAX_TOTAL_OPEN_RISK=0.20

# MT5 terminal
MT5_PATH=C:\Program Files\YourBroker MT5 Terminal\terminal64.exe
MT5_ATTACH_EXISTING_FIRST=true
MT5_ALLOW_TERMINAL_LAUNCH=false
MT5_LOCK_CONFIG=false
MT5_AUTO_TOGGLE_AUTOTRADE=false
MT5_ALLOW_ACCOUNT_SWITCH=false

# Demo MT5 account
DEMO_MT5_LABEL=VT Demo
DEMO_MT5_LOGIN=12345678
DEMO_MT5_PASSWORD=YourDemoPasswordHere
DEMO_MT5_SERVER=YourBroker-Demo
DEMO_MT5_SYMBOL_SUFFIX=
DEMO_MAX_SPREAD_PIPS=3.0

# Live MT5 accounts (max 3). Runtime ENV_MODE=live | live2 | live3
LIVE_MT5_LABEL=Live 1
LIVE_MT5_LOGIN=12345678
LIVE_MT5_PASSWORD=YourLivePasswordHere
LIVE_MT5_SERVER=YourBroker-Live
LIVE_MT5_SYMBOL_SUFFIX=
LIVE_MAX_SPREAD_PIPS=3.0

LIVE2_MT5_LABEL=Live 2
LIVE2_MT5_LOGIN=
LIVE2_MT5_PASSWORD=
LIVE2_MT5_SERVER=
LIVE2_MT5_SYMBOL_SUFFIX=
LIVE2_MAX_SPREAD_PIPS=3.0

LIVE3_MT5_LABEL=Live 3
LIVE3_MT5_LOGIN=
LIVE3_MT5_PASSWORD=
LIVE3_MT5_SERVER=
LIVE3_MT5_SYMBOL_SUFFIX=
LIVE3_MAX_SPREAD_PIPS=3.0

# Database. docker-compose maps localhost:3308 -> container:3306.
DB_HOST=localhost
DB_PORT=3308
DB_NAME=botsignal
DB_USER=root
DB_PASSWORD=rootpass
TRADE_REQUIRES_DB=true
MANUAL_TRADE_REQUIRES_DB=false
MANUAL_TRADE_DEDUPE_ENABLED=true
MANUAL_TRADE_COOLDOWN_SECS=60
DB_CONNECT_TIMEOUT_SECS=3

# Risk and guards
RISK_PERCENT=0.005
RISK_PIPS=500
RISK_PIPS_XAUUSD=1000
MIN_LOT=0.01
MAX_LOT=0.50
MIN_MARGIN_LEVEL=300
MIN_RR_RATIO=1.4
ENTRY_MAX_DISTANCE_PIPS=50
MAX_DAILY_LOSS_USD=50
MAX_DCA_LAYERS_PER_SYMBOL=3
BLOCK_SAME_DIRECTION_STACK=true
STACK_MODE=reduce

# Signal timing and execution
SIGNAL_EXPIRY=1800
WATCH_INTERVAL_SECS=30
TRADE_SPLIT=1
SESSION_FILTER_ENABLED=true
SESSION_START_HOUR_UTC=7
SESSION_END_HOUR_UTC=21

# Profit lock and trailing
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_PIPS=50
PROFIT_LOCK_TP_PIPS=100
TRAIL_ENABLED=true
TRAIL_PIPS=20

# AutoZone and layered DCA
MAP_ENABLED=true
LAYER_MODE=false
LAYER_COUNT=7
LAYER2_PIPS=35
MAX_SUB_SPLITS=4
L2_GAP_RATIO=0.40
L2_MIN_RUNWAY_PIPS=25
L1_LOT_RATIO=0.30

# Manual gold commands
MANUAL_SYMBOL=XAUUSD
MANUAL_SL_PIPS=50
MANUAL_TP1_PIPS=50
MANUAL_TP2_PIPS=80
MANUAL_RISK_PERCENT=0.10

# Fib and trend tools
FIB_GUARD_ENABLED=true
FIB_MAX_RETRACEMENT=0.382
FIB_SCANNER_ENABLED=true
FIB_SCANNER_INTERVAL=60
TREND_ENABLED=true
TREND_INTERVAL=60
TREND_EMA_SHORT=9
TREND_EMA_LONG=21
TREND_RSI_PERIOD=14

# Night agent. In live mode, auto-execution also requires AGENT_LIVE_UNLOCKED=true.
AGENT_ENABLED=true
AGENT_START_HOUR_MY=22
AGENT_END_HOUR_MY=6
AGENT_AUTO_EXECUTE=false
AGENT_LIVE_UNLOCKED=false

# Full-auto strategy. In live mode, auto-trading requires STRATEGY_LIVE_UNLOCKED=true.
# ACTIVE_STRATEGY selects a registered plugin (default = current breakout-retest V1).
# Compatibility alias: breakout_retest → breakout_retest_v1
ACTIVE_STRATEGY=breakout_retest_v1
STRATEGY_ENABLED=false
STRATEGY_SYMBOL=XAUUSD
STRATEGY_TIMEFRAME=M15
STRATEGY_SCAN_INTERVAL=60
STRATEGY_RISK_PERCENT=0.005
STRATEGY_DAILY_DRAWDOWN_PERCENT=3.0
STRATEGY_LIVE_UNLOCKED=false
STRATEGY_MIN_RR=1.4
STRATEGY_BREAKOUT_LOOKBACK=20
STRATEGY_RETEST_TOLERANCE_PIPS=20
STRATEGY_CONFIRM_BODY_RATIO=0.45
STRATEGY_SWING_BUFFER_PIPS=10
STRATEGY_TP_R_MULTIPLE=1.5
STRATEGY_PARTIAL_CLOSE_R=1.0
STRATEGY_PARTIAL_CLOSE_PERCENT=50

# Startup safety
TELEGRAM_DROP_PENDING_UPDATES=true
MT5_STARTUP_TIMEOUT_SECS=60
CONFIRM_LIVE_INJECT=NO
DASHBOARD_POLLER_ENABLED=false
DASHBOARD_MT5_LIVE_ENABLED=false
